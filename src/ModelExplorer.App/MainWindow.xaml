<Window x:Class="ModelExplorer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hx="http://helix-toolkit.org/wpf/SharpDX"
        xmlns:vm="clr-namespace:ModelExplorer.App.ViewModels"
        xmlns:thumbs="clr-namespace:ModelExplorer.App.Thumbnails"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        thumbs:ThumbnailImage.Service="{Binding Thumbnails}"
        Title="3D Model Explorer"
        Height="820" Width="1400"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        AllowDrop="True"
        Drop="OnFileDropped"
        DragOver="OnDragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- ══ Results: list skin ══ -->
        <ItemsPanelTemplate x:Key="ModelRowPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ModelRowTemplate">
            <!-- Two lines rather than four columns: the pane is narrow by
                 default, and name over folder with the numbers right-aligned
                 stays readable at any width. -->
            <Grid ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="0" Grid.Column="1"
                           Margin="10,0,0,0"
                           Style="{StaticResource StatusTextStyle}"
                           Text="{Binding Size, Converter={StaticResource FileSizeConverter}}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource StatusTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Folder}" />

                <TextBlock Grid.Row="1" Grid.Column="1"
                           Margin="10,0,0,0"
                           Style="{StaticResource StatusTextStyle}"
                           Text="{Binding ModifiedUtc, Converter={StaticResource LocalTimeConverter}}" />
            </Grid>
        </DataTemplate>

        <!-- ══ Results: grid skin ══ -->
        <ItemsPanelTemplate x:Key="ModelTilePanel">
            <!-- ItemSize is supplied rather than measured: with every tile the
                 same size the panel can compute which rows intersect the
                 viewport, instead of realizing containers to find out. -->
            <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                       ItemSize="{Binding Library.TileSize}"
                                       SpacingMode="Uniform"
                                       StretchItems="False" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ModelTileTemplate">
            <StackPanel Width="{Binding DataContext.Library.ThumbnailSize,
                                RelativeSource={RelativeSource AncestorType=ListBox}}"
                        ToolTip="{Binding FullPath}">
                <Grid Height="{Binding DataContext.Library.ThumbnailSize,
                               RelativeSource={RelativeSource AncestorType=ListBox}}">
                    <!-- Shown until the render lands. The thumbnail has a
                         transparent background, so this cannot simply sit
                         behind it — it would show through the model. -->
                    <materialDesign:PackIcon x:Name="Placeholder"
                                             Kind="CubeOutline"
                                             Width="32" Height="32"
                                             Visibility="Collapsed"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Foreground="{StaticResource PanelBorderBrush}" />

                    <Image x:Name="Thumbnail"
                           Stretch="Uniform"
                           StretchDirection="DownOnly"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           thumbs:ThumbnailImage.SourceFile="{Binding}" />
                </Grid>

                <TextBlock Text="{Binding Name}"
                           Margin="0,4,0,0"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxHeight="32"
                           TextWrapping="Wrap" />
            </StackPanel>

            <DataTemplate.Triggers>
                <Trigger SourceName="Thumbnail" Property="Source" Value="{x:Null}">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenModelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource ChromeBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Cube"
                                             Width="22" Height="22"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    <TextBlock Text="3D Model Explorer"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Grid.Column="1"
                         Margin="24,0"
                         MaxWidth="520"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Center"
                         IsEnabled="{Binding Library.IsReady}"
                         Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Search models…"
                         materialDesign:TextFieldAssist.HasClearButton="True" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding OpenModelCommand}"
                            ToolTip="Open a model (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileOutline" VerticalAlignment="Center" />
                            <TextBlock Text="Open Model" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{Binding Library.AddRootCommand}"
                            ToolTip="Add library folder">
                        <materialDesign:PackIcon Kind="FolderPlusOutline" />
                    </Button>
                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            IsEnabled="False" ToolTip="Settings (Step 8)">
                        <materialDesign:PackIcon Kind="CogOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Three-pane body ═════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RootsColumn" Width="240" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ResultsColumn" Width="360" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ViewerColumn" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <!-- Search metadata stays in the sidebar: it remains visible
                         while the results pane is narrow and does not compete with
                         the primary search box for header width.

                         First in the pane, not last, because these are drop downs.
                         Docked at the bottom the nine sort options would open past
                         the bottom edge of the window and spill onto the desktop.
                         It also puts the pane in reading order — search, refine,
                         then browse — and leaves the LIBRARY header attached to
                         the tree it labels. -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,4,12,12">
                        <StackPanel>
                            <TextBlock Text="SORT &amp; FILTERS"
                                       Style="{StaticResource PanelHeaderStyle}"
                                       Margin="0,6,0,6" />

                            <ComboBox ItemsSource="{Binding Library.SortOptions}"
                                      SelectedItem="{Binding Library.SelectedSort}"
                                      DisplayMemberPath="Label"
                                      Margin="0,0,0,8"
                                      materialDesign:HintAssist.Hint="Sort by" />

                            <ComboBox ItemsSource="{Binding Library.ExtensionFilters}"
                                      SelectedItem="{Binding Library.SelectedExtensionFilter}"
                                      DisplayMemberPath="Label"
                                      Margin="0,0,0,8"
                                      materialDesign:HintAssist.Hint="Format" />

                            <ComboBox ItemsSource="{Binding Library.SizeFilters}"
                                      SelectedItem="{Binding Library.SelectedSizeFilter}"
                                      DisplayMemberPath="Label"
                                      materialDesign:HintAssist.Hint="File size" />
                        </StackPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="LIBRARY" Style="{StaticResource PanelHeaderStyle}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,6,0">
                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding Library.ClearFolderFilterCommand}"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip="Show every folder"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    Visibility="{Binding Library.HasFolderFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding Library.AddRootCommand}"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip="Add folder">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding Library.RescanCommand}"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip="Rescan every folder"
                                    Visibility="{Binding Library.IsScanning, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Command="{Binding Library.CancelScanCommand}"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip="Cancel scan"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                    Visibility="{Binding Library.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="StopCircleOutline" Width="16" Height="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom"
                               Style="{StaticResource StatusTextStyle}"
                               Margin="12,6,12,10"
                               TextWrapping="Wrap"
                               Text="{Binding Library.ModelCountText}" />

                    <!-- The folder tree is also the roots list — the roots are its
                         top level. Selecting any node restricts the results to that
                         subtree; the filter-clear button in the header undoes it. -->
                    <Grid>
                        <TreeView ItemsSource="{Binding Library.FolderTree}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Margin="2,0"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                    <!-- Two-way, because both flags are also written by the
                                         view model: selection is restored after a rescan, and
                                         the clear-filter button drops the highlight. -->
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid x:Name="NodeRow" ToolTip="{Binding FullPath}" Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Width="16" Height="16"
                                                                 Margin="0,1,7,0"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="{StaticResource TextMutedBrush}"
                                                                 Kind="{Binding Converter={StaticResource FolderIconConverter}}" />

                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="NodeName"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Counts only on roots. One per folder turns a
                                                 deep tree into a wall of numbers, and the row
                                                 height doubles for every node. -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding CountText}" Style="{StaticResource StatusTextStyle}" />
                                                <TextBlock Text="  ·  not fully scanned"
                                                           Style="{StaticResource StatusTextStyle}"
                                                           Visibility="{Binding Root.IsIncomplete, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                x:Name="RemoveButton"
                                                Style="{StaticResource MaterialDesignToolButton}"
                                                Width="22" Height="22" Padding="0"
                                                Opacity="0"
                                                VerticalAlignment="Top"
                                                ToolTip="Remove from library"
                                                Visibility="{Binding IsRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.Library.RemoveRootCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Root}">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                    </Grid>

                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                            <Setter TargetName="NodeName" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>

                                        <!-- Remove is hidden until the row is hovered: it is
                                             destructive and there is one per root. -->
                                        <Trigger SourceName="NodeRow" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RemoveButton" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <TextBlock Style="{StaticResource PlaceholderStyle}" Margin="16"
                                   Text="No library folders yet.&#x0a;&#x0a;Use + to add one."
                                   Visibility="{Binding Library.HasRoots, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitterStyle}" />

            <Border Grid.Column="2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,10,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="MODELS"
                                   Style="{StaticResource PanelHeaderStyle}"
                                   Margin="0" VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding Library.ResultStatus}"
                                   Style="{StaticResource StatusTextStyle}"
                                   HorizontalAlignment="Right"
                                   Margin="8,0"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Only meaningful for the grid, so it goes away with it
                                 rather than sitting there doing nothing. -->
                            <Slider Width="80"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Minimum="{Binding Library.MinimumThumbnailSize, Mode=OneTime}"
                                    Maximum="{Binding Library.MaximumThumbnailSize, Mode=OneTime}"
                                    Value="{Binding Library.ThumbnailSize}"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="8"
                                    ToolTip="Thumbnail size"
                                    Visibility="{Binding Library.IsGridView, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip="Clear cached thumbnails and render them again"
                                    Command="{Binding Library.ClearThumbnailCacheCommand}">
                                <materialDesign:PackIcon Kind="ImageRemoveOutline" Width="16" Height="16" />
                            </Button>

                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Width="26" Height="26"
                                          Margin="4,0,0,0"
                                          ToolTip="Switch between grid and list"
                                          IsChecked="{Binding Library.IsGridView}">
                                <materialDesign:PackIcon Kind="ViewList" Width="15" Height="15" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="ViewGridOutline" Width="15" Height="15" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <!-- Virtualization is explicit rather than left to defaults:
                             recycling containers and scrolling by pixel are what keep
                             a 100k-row list scrolling at frame rate. -->
                        <ListBox ItemsSource="{Binding Library.Models}"
                                 SelectedItem="{Binding Library.SelectedModel, Mode=TwoWay}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLengthUnit="Page"
                                 Visibility="{Binding Library.HasModels, Converter={StaticResource BooleanToVisibilityConverter}}">

                            <!-- Grid and list are one ListBox with two skins, not two
                                 controls. A second ListBox would mean a second two-way
                                 SelectedItem binding onto the same property, and the
                                 hidden one would fight the visible one every time the
                                 results are replaced. -->
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource MaterialDesignListBox}">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ModelRowTemplate}" />
                                    <Setter Property="ItemsPanel" Value="{StaticResource ModelRowPanel}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Library.IsGridView}" Value="True">
                                            <Setter Property="ItemTemplate" Value="{StaticResource ModelTileTemplate}" />
                                            <Setter Property="ItemsPanel" Value="{StaticResource ModelTilePanel}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="Padding" Value="10,5" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                                    <!-- A context menu lives in its own visual tree and cannot
                                         walk up to the window for the commands, so Tag carries
                                         the view model across the gap. One menu instance is
                                         shared by every row — a Setter value always is — hence
                                         both bindings go through PlacementTarget explicitly
                                         rather than leaning on an inherited DataContext.
                                         The row acted on is the one right-clicked, which need
                                         not be the selected one. -->
                                    <Setter Property="Tag"
                                            Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Header="Open in Explorer"
                                                          Command="{Binding PlacementTarget.Tag.RevealCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.FullPath,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="FolderSearchOutline" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Copy path"
                                                          Command="{Binding PlacementTarget.Tag.CopyPathCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext.FullPath,
                                                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="ContentCopy" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <!-- Tiles are a fixed size and centred; rows stretch.
                                             The padding has to agree with TileSize or the
                                             panel's arithmetic and the content disagree. -->
                                        <DataTrigger Binding="{Binding DataContext.Library.IsGridView,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                     Value="True">
                                            <Setter Property="Padding" Value="8,4" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>

                        </ListBox>

                        <TextBlock Style="{StaticResource PlaceholderStyle}" Margin="16"
                                   Visibility="{Binding Library.HasModels, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                   Text="{Binding Library.EmptyModelsText}" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Style="{StaticResource PaneSplitterStyle}" />

            <!-- ══ Viewport ══ -->
            <Grid Grid.Column="4" Background="{StaticResource ViewportBackgroundBrush}">

                <hx:Viewport3DX x:Name="Viewport"
                                Camera="{Binding Camera}"
                                EffectsManager="{Binding EffectsManager}"
                                BackgroundColor="#FF1A1A1A"
                                ShowViewCube="True"
                                ShowCoordinateSystem="True"
                                ShowFrameRate="True"
                                IsChangeFieldOfViewEnabled="False"
                                FXAALevel="Low"
                                MSAA="Disable"
                                MouseRightButtonDown="OnViewportRightButtonDown"
                                PreviewMouseLeftButtonDown="OnViewportPreviewLeftButtonDown"
                                PreviewMouseLeftButtonUp="OnViewportPreviewLeftButtonUp"
                                ModelUpDirection="0,0,1"
                                CameraRotationMode="Turntable"
                                UseDefaultGestures="False">

                    <!-- Defaults are off so the bindings below fully define the
                         scheme: left orbits, middle pans, right sets the pivot
                         (handled in code-behind, since it needs a raycast).
                         Wheel zoom is intrinsic to the camera controller and is
                         unaffected by these bindings. -->
                    <hx:Viewport3DX.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="hx:ViewportCommands.Rotate" />
                        <MouseBinding Gesture="MiddleClick" Command="hx:ViewportCommands.Pan" />
                        <MouseBinding Gesture="Shift+LeftClick" Command="hx:ViewportCommands.Pan" />
                        <MouseBinding Gesture="Ctrl+LeftClick" Command="hx:ViewportCommands.Zoom" />
                        <KeyBinding Key="F" Command="hx:ViewportCommands.ZoomExtents" />

                        <!-- Scoped to the viewport rather than the window: an
                             unmodified letter binding at window level fires while
                             the search box has focus, so typing "b" would toggle
                             the box. -->
                        <KeyBinding Key="B" Command="{Binding ToggleBoundingBoxCommand}" />
                        <KeyBinding Key="P" Command="{Binding ToggleBuildPlateCommand}" />
                        <KeyBinding Key="C" Command="{Binding ToggleCutPlaneCommand}" />
                        <KeyBinding Key="A" Command="{Binding ToggleAppearanceOptionsCommand}" />
                    </hx:Viewport3DX.InputBindings>

                    <!-- A configurable main/fill/rim rig. Ambient remains a
                         separate control so dark faces can be lifted without
                         washing out the directional shape cues. -->
                    <hx:AmbientLight3D Color="{Binding AmbientLightColor}" />
                    <hx:DirectionalLight3D Direction="{Binding MainLightDirection}"
                                           Color="{Binding MainLightColor}"
                                           IsRendering="{Binding MainLightEnabled}" />
                    <hx:DirectionalLight3D Direction="{Binding FillLightDirection}"
                                           Color="{Binding FillLightColor}"
                                           IsRendering="{Binding FillLightEnabled}" />
                    <hx:DirectionalLight3D Direction="{Binding RimLightDirection}"
                                           Color="{Binding RimLightColor}"
                                           IsRendering="{Binding RimLightEnabled}" />

                    <!-- The committed model is either the untouched source or a
                         real CPU-generated cut with cap triangles. During handle
                         movement it is swapped for Helix's immediate shader
                         preview below, then restored as soon as the real mesh is
                         ready. -->
                    <hx:MeshGeometryModel3D x:Name="CommittedModel"
                                            Geometry="{Binding Mesh}"
                                            Material="{Binding ModelMaterial}"
                                            FillMode="{Binding ModelFillMode}"
                                            RenderWireframe="{Binding RenderModelEdges}"
                                            WireframeColor="{Binding ModelWireframeColor}"
                                            Visibility="{Binding ShowsCommittedModel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <hx:CrossSectionMeshGeometryModel3D x:Name="CutPreviewModel"
                                                        Geometry="{Binding OriginalMesh}"
                                                        Material="{Binding ModelMaterial}"
                                                        FillMode="{Binding ModelFillMode}"
                                                        RenderWireframe="{Binding RenderModelEdges}"
                                                        WireframeColor="{Binding ModelWireframeColor}"
                                                        EnablePlane1="True"
                                                        Plane1="{Binding CutPlane}"
                                                        CuttingOperation="Intersect"
                                                        CrossSectionColor="#FFFF963D"
                                                        Visibility="{Binding ShowsCutPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- A local XY square transformed by the manipulator. It is
                         visual only and cannot steal surface picks from the
                         model; the handles remain hit-testable. -->
                    <hx:MeshGeometryModel3D Geometry="{Binding CutPlaneSurface}"
                                            Transform="{Binding CutPlaneTransform}"
                                            Material="{Binding CutPlaneMaterial}"
                                            CullMode="None"
                                            IsTransparent="True"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <hx:LineGeometryModel3D Geometry="{Binding CutPlaneOutline}"
                                            Transform="{Binding CutPlaneTransform}"
                                            Color="#FFFF963D"
                                            Thickness="1.2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Rotation is free around all local axes. Translation is
                         deliberately local Z only: movement parallel to an
                         infinite plane would not change the cut. -->
                    <hx:UICompositeManipulator3D x:Name="CutPlaneManipulator"
                                                     CanRotateX="True"
                                                     CanRotateY="True"
                                                     CanRotateZ="True"
                                                     CanTranslateX="False"
                                                     CanTranslateY="False"
                                                     CanTranslateZ="True"
                                                     Diameter="{Binding CutPlaneManipulatorDiameter}"
                                                     TargetTransform="{Binding CutPlaneTransform, Mode=TwoWay}"
                                                     Transform="{Binding CutPlaneTransform, Mode=TwoWay}"
                                                     Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- The composite manipulator supplies +Z. Its arrow can be
                         hidden inside the retained half, so a matching -Z arrow
                         keeps plane translation reachable from either side. -->
                    <hx:UITranslateManipulator3D Direction="0,0,-1"
                                                 Length="{Binding CutPlaneManipulatorDiameter}"
                                                 Diameter="{Binding CutPlaneHandleDiameter}"
                                                 Material="{x:Static hx:DiffuseMaterials.Blue}"
                                                 TargetTransform="{Binding CutPlaneTransform, Mode=TwoWay}"
                                                 Transform="{Binding CutPlaneTransform, Mode=TwoWay}"
                                                 Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Build plate, drawn under the model as a sense of scale and
                         a fit check. Three layers: bed surface, 10 mm grid, then
                         the edge and 50 mm lines over the top. All share one
                         transform, and none is hit-testable — the plate is wider
                         than the model, so it would otherwise swallow every
                         right-click aimed past its silhouette. -->
                    <hx:MeshGeometryModel3D Geometry="{Binding PlateSurface}"
                                            Transform="{Binding PlateTransform}"
                                            Material="{Binding PlateMaterial}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowBuildPlate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <hx:LineGeometryModel3D Geometry="{Binding PlateGrid}"
                                            Transform="{Binding PlateTransform}"
                                            Color="#FF3C424B"
                                            Thickness="0.8"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowBuildPlate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Two outline models rather than one with a rebound colour,
                         so both colours stay literals the XAML compiler checks.
                         Red is the whole point of the plate: it says the model
                         will not print on the selected machine. -->
                    <hx:LineGeometryModel3D Geometry="{Binding PlateOutline}"
                                            Transform="{Binding PlateTransform}"
                                            Color="#FF6E7A88"
                                            Thickness="1.2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowsPlateFits, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <hx:LineGeometryModel3D Geometry="{Binding PlateOutline}"
                                            Transform="{Binding PlateTransform}"
                                            Color="#FFE05252"
                                            Thickness="1.2"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowsPlateOverrun, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Bounding box. Like the pivot marker, never hit-testable:
                         it surrounds the model, so every right-click meant for
                         the model would otherwise land on a face of the box. -->
                    <hx:LineGeometryModel3D Geometry="{Binding BoundingBoxGeometry}"
                                            Transform="{Binding BoundingBoxTransform}"
                                            Color="#FF4DD0E1"
                                            Thickness="1"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding ShowBoundingBox, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- FixedSize keeps the measurements legible at any zoom;
                         scaled with the scene they would be unreadable on a
                         200 mm print and fill the viewport on a 5 mm one. -->
                    <hx:BillboardTextModel3D Geometry="{Binding BoundingBoxLabels}"
                                             FixedSize="True"
                                             IsHitTestVisible="False"
                                             Visibility="{Binding ShowBoundingBox, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Pivot marker. Never hit-testable, or right-clicking it
                         would pick the marker instead of the model behind it. -->
                    <hx:MeshGeometryModel3D Geometry="{Binding PivotMarker}"
                                            Transform="{Binding PivotTransform}"
                                            Material="{Binding PivotMaterial}"
                                            IsHitTestVisible="False"
                                            Visibility="{Binding HasPivot, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </hx:Viewport3DX>

                <!-- Viewport tools. Overlaid at top-left because they act on what
                     is in the viewport, and because Helix puts the ViewCube in
                     the opposite corner. -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="12"
                        Padding="3"
                        CornerRadius="4"
                        Background="#CC202020"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1"
                        Visibility="{Binding HasModel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Width="26" Height="26"
                                          ToolTip="Show the model's bounding box and its dimensions (B)"
                                          IsChecked="{Binding ShowBoundingBox}">
                                <materialDesign:PackIcon Kind="CubeOutline" Width="15" Height="15" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="CubeScan" Width="15" Height="15" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Width="26" Height="26"
                                          Margin="6,0,0,0"
                                          ToolTip="Show a printer's build plate under the model (P)"
                                          IsChecked="{Binding ShowBuildPlate}">
                                <materialDesign:PackIcon Kind="Grid" Width="15" Height="15" />
                                <materialDesign:ToggleButtonAssist.OnContent>
                                    <materialDesign:PackIcon Kind="Printer3d" Width="15" Height="15" />
                                </materialDesign:ToggleButtonAssist.OnContent>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Width="26" Height="26"
                                          Margin="6,0,0,0"
                                          ToolTip="Cut the model with one freely rotatable plane (C)"
                                          IsChecked="{Binding ShowCutPlane}">
                                <materialDesign:PackIcon Kind="BoxCutter" Width="15" Height="15" />
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource MaterialDesignActionToggleButton}"
                                          Width="26" Height="26"
                                          Margin="6,0,0,0"
                                          ToolTip="Lighting, shading and model colour (A)"
                                          IsChecked="{Binding ShowAppearanceOptions}">
                                <materialDesign:PackIcon Kind="PaletteOutline" Width="15" Height="15" />
                            </ToggleButton>

                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Width="26" Height="26" Padding="0"
                                    Margin="4,0,0,0"
                                    ToolTip="Keep the other side of the cutting plane"
                                    Command="{Binding FlipCutSideCommand}"
                                    Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" />
                            </Button>

                            <Button Style="{StaticResource MaterialDesignToolButton}"
                                    Width="26" Height="26" Padding="0"
                                    ToolTip="Reset the cutting plane to the model centre"
                                    Command="{Binding ResetCutPlaneCommand}"
                                    Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Kind="Restore" Width="15" Height="15" />
                            </Button>

                            <!-- Appears with the plate rather than sitting there inert:
                                 a printer picker means nothing with no bed on screen. -->
                            <ComboBox Width="196"
                                      Margin="8,0,2,0"
                                      VerticalAlignment="Center"
                                      ItemsSource="{Binding BuildPlateOptions}"
                                      SelectedItem="{Binding SelectedBuildPlate}"
                                      DisplayMemberPath="Label"
                                      ToolTip="Printer whose build plate is shown"
                                      Visibility="{Binding ShowBuildPlate, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <TextBlock Margin="5,3,5,2"
                                   MaxWidth="330"
                                   Style="{StaticResource StatusTextStyle}"
                                   Text="{Binding CutPlaneStatusText}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding ShowCutPlane, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Width="326"
                                Margin="3,5,3,3"
                                Padding="9,7,9,9"
                                CornerRadius="3"
                                Background="#B8181818"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                Visibility="{Binding ShowAppearanceOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="LIGHTING &amp; APPEARANCE"
                                           Style="{StaticResource PanelHeaderStyle}"
                                           Margin="0,0,0,6" />

                                <ComboBox ItemsSource="{Binding LightingOptions}"
                                          SelectedItem="{Binding SelectedLightingPreset}"
                                          DisplayMemberPath="Name"
                                          materialDesign:HintAssist.Hint="Lighting preset" />

                                <StackPanel Orientation="Horizontal" Margin="0,7,0,2">
                                    <TextBlock Text="Directional lights"
                                               Width="112"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <CheckBox Content="Main"
                                              IsChecked="{Binding MainLightEnabled}"
                                              Margin="0,0,9,0" />
                                    <CheckBox Content="Fill"
                                              IsChecked="{Binding FillLightEnabled}"
                                              Margin="0,0,9,0" />
                                    <CheckBox Content="Rim"
                                              IsChecked="{Binding RimLightEnabled}" />
                                </StackPanel>

                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Content="Ambient"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding AmbientLightEnabled}" />
                                    <Slider Grid.Column="1"
                                            Margin="4,0,8,0"
                                            VerticalAlignment="Center"
                                            Minimum="0" Maximum="1"
                                            IsEnabled="{Binding AmbientLightEnabled}"
                                            Value="{Binding AmbientLightIntensity}" />
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding AmbientLightIntensity, StringFormat={}{0:P0}}" />
                                </Grid>

                                <Grid Margin="0,3,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0"
                                              Content="Rotate main"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding AutoRotateLight}" />
                                    <Slider Grid.Column="1"
                                            Margin="4,0,8,0"
                                            VerticalAlignment="Center"
                                            Minimum="10" Maximum="120"
                                            IsEnabled="{Binding AutoRotateLight}"
                                            Value="{Binding LightRotationSpeed}" />
                                    <TextBlock Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Text="{Binding LightRotationSpeed, StringFormat={}{0:N0}°/s}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding ShadingOptions}"
                                              SelectedItem="{Binding SelectedShading}"
                                              DisplayMemberPath="Name"
                                              materialDesign:HintAssist.Hint="Shading" />

                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding ModelColorOptions}"
                                              SelectedItem="{Binding SelectedModelColor}"
                                              materialDesign:HintAssist.Hint="Model colour">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="13" Height="13"
                                                            Margin="0,0,7,0"
                                                            CornerRadius="2"
                                                            Background="{Binding Swatch}"
                                                            BorderBrush="#66FFFFFF"
                                                            BorderThickness="1" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Empty state, hidden as soon as geometry exists -->
                <TextBlock Style="{StaticResource PlaceholderStyle}"
                           IsHitTestVisible="False"
                           Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="No model loaded&#x0a;&#x0a;Ctrl+O, or drop an .stl or .3mf file here" />

                <!-- Error state. A corrupt or unreadable file gets a named reason
                     and a way to go look at it, rather than a blank viewport that
                     is indistinguishable from "still loading". -->
                <Border MaxWidth="460" Margin="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{StaticResource PanelBackgroundBrush}"
                        BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="24,20"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircleOutline"
                                                     Width="22" Height="22"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource ValidationErrorBrush}" />
                            <TextBlock Text="{Binding ModelName}"
                                       Margin="10,0,0,0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMutedBrush}" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Command="{Binding CopyPathCommand}"
                                    CommandParameter="{Binding CurrentPath}"
                                    Content="COPY PATH" />
                            <Button Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="8,0,0,0"
                                    Command="{Binding RevealCommand}"
                                    CommandParameter="{Binding CurrentPath}"
                                    Content="OPEN IN EXPLORER" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Busy indicator -->
                <Border Background="#99000000"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0" IsIndeterminate="True"
                                     Width="42" Height="42" />
                        <TextBlock Text="{Binding ModelName}"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ Status bar ══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource ChromeBackgroundBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource StatusTextStyle}" />

                <!-- Scan progress gets its own cell rather than sharing the message
                     line, so a running scan and a model load never overwrite each
                     other's text. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0"
                            Visibility="{Binding Library.ScanStatus, Converter={StaticResource NonEmptyToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Width="13" Height="13" Margin="0,0,7,0"
                                 Value="0" IsIndeterminate="True"
                                 Visibility="{Binding Library.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Library.ScanStatus}" Style="{StaticResource StatusTextStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Bound to CurrentPath rather than to the selected row, so
                         these also work for a file opened with Ctrl+O or dropped
                         on the window, which has no row in the library at all. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                Visibility="{Binding HasCurrentPath, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Width="22" Height="22" Padding="0"
                                ToolTip="Copy path"
                                Command="{Binding CopyPathCommand}"
                                CommandParameter="{Binding CurrentPath}">
                            <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource MaterialDesignToolButton}"
                                Width="22" Height="22" Padding="0"
                                ToolTip="Open in Explorer"
                                Command="{Binding RevealCommand}"
                                CommandParameter="{Binding CurrentPath}">
                            <materialDesign:PackIcon Kind="FolderSearchOutline" Width="14" Height="14" />
                        </Button>
                    </StackPanel>

                    <!-- Fit verdict sits ahead of the dimensions: when a model does
                         not print, that is the first thing worth reading. -->
                    <TextBlock Text="{Binding PlateFitText}"
                               Style="{StaticResource StatusTextStyle}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                               Visibility="{Binding ShowsPlateFits, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding PlateFitText}"
                               Style="{StaticResource StatusTextStyle}"
                               Foreground="{DynamicResource ValidationErrorBrush}"
                               Visibility="{Binding ShowsPlateOverrun, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="  ·  " Style="{StaticResource StatusTextStyle}"
                               Visibility="{Binding PlateFitText, Converter={StaticResource NonEmptyToVisibilityConverter}}" />

                    <TextBlock Text="{Binding DimensionsText}" Style="{StaticResource StatusTextStyle}" />
                    <TextBlock Text="  ·  " Style="{StaticResource StatusTextStyle}"
                               Visibility="{Binding DimensionsText, Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                    <TextBlock Text="{Binding TriangleCountText}" Style="{StaticResource StatusTextStyle}" />
                    <TextBlock Text="  ·  " Style="{StaticResource StatusTextStyle}"
                               Visibility="{Binding TimingText, Converter={StaticResource NonEmptyToVisibilityConverter}}" />
                    <TextBlock Text="{Binding TimingText}" Style="{StaticResource StatusTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
